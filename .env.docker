# Docker Environment Variables
# Format: UPPERCASE_WITH_UNDERSCORE (otomatis diconvert oleh Viper ke dotted notation)
# Contoh: DB_CONFIGS_HOST -> db.configs.host

# Application
APPLICATION_NAME=auth-system
APPLICATION_ENV=development
APPLICATION_PORT=8080

# Database Configuration (External Container)
# Pastikan container database Anda bernama 'db_postgres'
DB_CONFIGS_HOST=db_postgres
DB_CONFIGS_PORT=5432
DB_CONFIGS_USER=postgres
DB_CONFIGS_PASSWORD=your_password_here
DB_CONFIGS_NAME=authentication_db
DB_CONFIGS_SSLMODE=disable
DB_CONFIGS_MAXIDLECONN=10
DB_CONFIGS_MAXOPENCONN=100

# JWT Configuration
AUTH_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
AUTH_JWT_ACCESS_TOKEN_EXPIRE=15m
AUTH_JWT_REFRESH_TOKEN_EXPIRE=7d

# OTP Configuration
AUTH_OTP_EXPIRE=5m
AUTH_OTP_LENGTH=6
