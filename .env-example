# Application
application.name=auth-system
application.env=development
application.port=8080

# Database
db.configs.host=localhost
db.configs.port=5432
db.configs.user=postgres
db.configs.password=your_password_here
db.configs.name=authentication_db
db.configs.sslmode=disable

# JWT
auth.jwt.secret=your-super-secret-jwt-key-change-this-in-production
auth.jwt.access_token_expire=15m
auth.jwt.refresh_token_expire=7d

# OTP
auth.otp.expire=5m
auth.otp.length=6
