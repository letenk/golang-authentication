# Application
APPLICATION_NAME=auth-system
APPLICATION_ENV=development
APPLICATION_PORT=8080

# Database
# When using Docker: DB_CONFIGS_HOST must match the PostgreSQL container name on the shared network
# When running locally without Docker: DB_CONFIGS_HOST=localhost
DB_CONFIGS_HOST=db_postgres
DB_CONFIGS_PORT=5432
DB_CONFIGS_USER=postgres
DB_CONFIGS_PASSWORD=your_password_here
DB_CONFIGS_NAME=authentication_db
DB_CONFIGS_SSLMODE=disable
DB_CONFIGS_MAXIDLECONN=10
DB_CONFIGS_MAXOPENCONN=100

# JWT
AUTH_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
AUTH_JWT_ACCESS_TOKEN_EXPIRE=15m
AUTH_JWT_REFRESH_TOKEN_EXPIRE=7d

# OTP
AUTH_OTP_EXPIRE=5m
AUTH_OTP_LENGTH=6

# Email SMTP (for forgot password OTP)
# Dev: use Mailtrap (https://mailtrap.io) or Mailhog
# Prod: use Gmail SMTP, SendGrid SMTP, Mailgun, etc.
EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_mailtrap_username
EMAIL_SMTP_PASSWORD=your_mailtrap_password
EMAIL_SMTP_FROM=noreply@auth-system.com
